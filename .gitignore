# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated marketing video exports + intermediate frames
# (out/ is already ignored above; listing explicitly for discoverability)
/out/iphone-frames-*/
/out/iphone-mockup-*.mov

# self-contained Remotion drop-in exports (eagle-site code packaged
# for use in external Remotion projects). Holds duplicated copies of
# /public/hero-phone/*.png, ~10 MB, no need to ship in git.
/exports/

# Debug HTML dumps from scripts/convert-tc-docs.mjs (the .ts modules
# it emits into app/terms/_content/ are the tracked source of truth).
/scripts/_tc-output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
